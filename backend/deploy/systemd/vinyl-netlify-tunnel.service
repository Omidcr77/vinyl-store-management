[Unit]
Description=Vinyl Store Netlify test tunnel with automatic proxy republishing
After=vinyl-api.service vinyl-public-proxy.service
Wants=vinyl-api.service vinyl-public-proxy.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/omid/projects/vinyl-store-management
EnvironmentFile=/home/omid/projects/vinyl-store-management/.data/netlify-tunnel.env
ExecStart=/usr/bin/node scripts/netlify-test-tunnel.mjs
Restart=on-failure
RestartSec=30
TimeoutStopSec=15
NoNewPrivileges=true

[Install]
WantedBy=default.target
