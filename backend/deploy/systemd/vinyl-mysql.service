[Unit]
Description=Vinyl Store MySQL-compatible database (MariaDB)
PartOf=vinyl-store.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/omid/projects/vinyl-store-management
ExecStart=/usr/bin/node scripts/mysql-server.mjs
Restart=always
RestartSec=3
TimeoutStopSec=120
LimitNOFILE=64000
NoNewPrivileges=true

[Install]
WantedBy=vinyl-store.target
