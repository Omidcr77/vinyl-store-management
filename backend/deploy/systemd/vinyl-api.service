[Unit]
Description=Vinyl Store API
Wants=vinyl-mysql.service
After=vinyl-mysql.service
PartOf=vinyl-store.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/omid/projects/vinyl-store-management/backend
Environment=HOME=/home/omid
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
TimeoutStopSec=45
NoNewPrivileges=true

[Install]
WantedBy=vinyl-store.target
