{
  "name": "vinyl-store",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db": "node scripts/local-db.js",
    "admin:create": "node scripts/create-admin.mjs",
    "seed": "npm run seed -w backend",
    "build": "npm run build -w frontend",
    "test": "npm run test -w backend && node --test --test-concurrency=1 tests/startup.test.mjs tests/restart.test.mjs tests/calendar.test.mjs tests/public-proxy.test.mjs tests/security.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "db:setup": "node scripts/setup-mysql.mjs",
    "db:migrate": "node scripts/migrate-mongodb-to-mysql.mjs",
    "admin:reset": "node scripts/reset-admin.mjs",
    "build:netlify": "node scripts/build-netlify.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "http-proxy-3": "^1.22.0",
    "mongodb": "^7.7.0",
    "playwright": "^1.55.0",
    "prettier": "^3.9.9"
  }
}
